# Données brutes — jamais committées (volume, licences)
# Reconstituables via scripts/download_*, empreintes dans data/raw/PROVENANCE.md
/data/raw/*
!/data/raw/README.md
!/data/raw/PROVENANCE.md
!/data/raw/ods8.example.json

# Bases de production — générées par l'import, jamais versionnées
/storage/

# Sitemaps — artefacts generes par scripts/build_sitemaps.php depuis storage/seo_es.sqlite
# (jamais versionne, cf. ci-dessus) : jamais versionnes non plus, meme regime, regeneres a
# chaque deploiement via "php scripts/build_seo_registry.php && php scripts/apply_seo_batch.php
# ... && php scripts/apply_word_admitted_rollout.php ... && php scripts/build_sitemaps.php
# --base-url=...". Correctif I-8 (audit seo-technical-auditor, 2026-08-29) : ces 20 fichiers
# (19 fragments + sitemap-index.xml) etaient commites par erreur depuis ES-009 malgre
# l'affirmation contraire dans docs/DECISIONS.md -- retires du suivi git dans le meme commit
# que cette entree (voir docs/DECISIONS.md ES-011 pour le detail du correctif).
/public/sitemaps/
/public/sitemap-index.xml

# Cache de generation word_senses (D-043) — artefact de build cher a regenerer
# (appels API + verification + corrections manuelles), meme regime que /storage/ :
# jamais versionne (volume, ~140 Mo), jamais publie dans public/. Fusionne dans
# storage/dictionary_fr.sqlite par scripts/import_fr.py, seul artefact deploye.
/data/generated/

# Rapports générés — sauf reports/query-plans/, qui EST le seul artefact de traçabilité exigé par
# CLAUDE.md ("Toute requête nouvelle ou modifiée fournit son EXPLAIN QUERY PLAN, son temps
# d'exécution, son nombre de lignes, et un benchmark avant/après") : jamais versionné jusqu'ici sur
# ce dépôt (constat C-4, audit code-reviewer 2026-08-31), à la différence du dépôt FR cousin
# (40+ fichiers). Ces fichiers sont petits (texte), reproductibles à la main mais coûteux à
# refaire à l'identique — versionnés comme sur FR.
/reports/*
!/reports/.gitkeep
!/reports/query-plans/
!/reports/query-plans/**

# Python
__pycache__/
*.py[cod]

# Environnement
.env
.DS_Store
Thumbs.db

# Claude Code — local uniquement
/.claude/settings.local.json
/.claude/worktrees/
